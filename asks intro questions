@app.route("/", methods=["GET", "POST"])
def home():
    recommendations = []
    responses = {}
    if request.method == "POST":
        # Collect survey responses
        responses['comedy_rating'] = request.form.get("comedy_rating")
        responses['age_group'] = request.form.get("age_group")
        responses['books_per_year'] = request.form.get("books_per_year")

        # Collect book title
        title = request.form.get("title")
        recommendations = recommend_books(title)

    return render_template_string(html, recommendations=recommendations, responses=responses)

# Step 6: Run Flask app in a background thread + expose with ngrok
def run_app():
    app.run()

thread = threading.Thread(target=run_app)
thread.start()

